  "narrative": {
    "northStar": "抽丝剥茧 · 业务手记",
    "overview": "纸白像工作纸，墨色承载判断，蓝线呈现把复杂业务逐步理清的过程。首页的同一根 Canvas 线随正常滚动从非对称线团逐段展开，四种方法依次出现，最后分支连接两个职业项目及后置的 GrooveLog 个人项目。详页转为安静的阅读排版；线与节点仍作为内容线索。",
    "keyCharacteristics": [
      "大面积纸白留白、原生中文无衬线字和少量线蓝。",
      "首页侧方文字与连续线团同台；手机图形在上、文字在下。",
      "真实案例分层阅读，项目阶段、职责和成果按事实呈现。"
    ],
    "rules": [
      { "name": "The One Thread Rule", "body": "蓝色首先表达同一条问题线和可行动路径；不要把它扩展为大面积装饰底色。", "section": "colors" },
      { "name": "The Short Method Rule", "body": "首页每一方法只用一句判断和一条具体做法；解释与事实进入案例详情。", "section": "typography" }
    ],
    "dos": [
      "Do 保持一根连续线的身份，让方法出现与局部解线同步。",
      "Do 让滚动、键盘、减少动态效果和无脚本读者都能到达项目与联系方式。",
      "Do 在案例详情标清项目阶段、职责、数据口径及流程示意性质。"
    ],
    "donts": [
      "Don't 把首页改成履历列表、能力卡网格或独立的选择对话。",
      "Don't 让蓝线穿过正文或项目文字，或把解线图当作真实业务指标图。",
      "Don't 为职业项目补造公开 Demo、客户原话、逐轮准确率曲线或未确认的事实。"
    ]
  }
